#!/bin/sh

agent_sock="${WSL_SSH_AGENT_SOCKET:-$HOME/.ssh/agent.sock}"
agent_pipe="${WSL_SSH_AGENT_PIPE:-//./pipe/openssh-ssh-agent}"
lock_file="${agent_sock}.lock"
relay_link="$HOME/.ssh/npiperelay-wsl.exe"

kernel_release() {
    if [ "${WSL_SSH_AGENT_KERNEL_RELEASE+set}" = "set" ]; then
        printf '%s\n' "$WSL_SSH_AGENT_KERNEL_RELEASE"
    else
        uname -r 2>/dev/null || true
    fi
}

is_wsl() {
    case "$(kernel_release)" in
        *[Mm]icrosoft*|*[Ww][Ss][Ll]*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

have_command() {
    command -v "$1" >/dev/null 2>&1
}

# 0: the agent answers. 1: the relay accepts connections but the Windows agent
# behind it does not answer. 2: nothing is listening.
have_agent() {
    [ -S "$agent_sock" ] || return 2
    have_command ssh-add || return 2

    agent_out="$(SSH_AUTH_SOCK="$agent_sock" ssh-add -l 2>/dev/null)"
    case $? in
        0)
            return 0
            ;;
        1)
            # An empty agent says so on stdout; a failed relay only writes to stderr.
            [ -n "$agent_out" ] || return 1
            return 0
            ;;
        *)
            return 2
            ;;
    esac
}

wait_for_agent() {
    i=0
    while [ "$i" -lt 20 ]; do
        have_agent
        case $? in
            0)
                return 0
                ;;
            1)
                return 1
                ;;
        esac
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

warn() {
    printf 'wsl-ssh-agent: %s\n' "$*" >&2
}

resolve_npiperelay() {
    if [ -n "${WSL_SSH_AGENT_NPIPERELAY:-}" ]; then
        printf '%s\n' "$WSL_SSH_AGENT_NPIPERELAY"
        return 0
    fi

    command -v npiperelay.exe 2>/dev/null
}

start_relay() {
    socat_bin="${WSL_SSH_AGENT_SOCAT:-}"
    if [ -z "$socat_bin" ]; then
        socat_bin="$(command -v socat 2>/dev/null || true)"
    fi
    npiperelay_bin="$(resolve_npiperelay || true)"

    if [ -z "$socat_bin" ]; then
        warn "socat not found; install it in WSL (sudo apt install socat)"
        return 1
    fi
    if [ -z "$npiperelay_bin" ]; then
        warn "npiperelay.exe not found on PATH; install it on Windows or set WSL_SSH_AGENT_NPIPERELAY"
        return 1
    fi

    mkdir -p "$(dirname "$agent_sock")"
    ln -sf "$npiperelay_bin" "$relay_link"

    # Replace a relay that is still listening but no longer answers, instead
    # of leaving it orphaned. unlink-close=0 keeps a dying relay from removing
    # the socket its successor has just bound.
    pkill -u "$(id -u)" -f "UNIX-LISTEN:$agent_sock," 2>/dev/null || true
    rm -f "$agent_sock"

    # 9>&- keeps the relay from inheriting (and so holding) the startup lock.
    nohup "$socat_bin" \
        "UNIX-LISTEN:$agent_sock,fork,mode=600,unlink-close=0" \
        "EXEC:$relay_link -ei -s $agent_pipe,nofork" \
        >/dev/null 2>&1 9>&- &

    if ! wait_for_agent; then
        warn "no answer from the Windows ssh-agent at $agent_pipe; is the ssh-agent service running?"
        return 1
    fi
}

ensure_agent() {
    is_wsl || return 0

    if have_agent; then
        return 0
    fi

    mkdir -p "$(dirname "$agent_sock")"

    # flock releases the lock when its holder exits, however it dies, so a
    # killed shell cannot leave a stale lock behind.
    (
        if ! flock -w 5 9; then
            warn "could not lock $lock_file"
            exit 1
        fi

        have_agent || start_relay
    ) 9>"$lock_file"
}

emit_env() {
    case "$1" in
        sh)
            printf "export SSH_AUTH_SOCK='%s'\n" "$agent_sock"
            ;;
        fish)
            printf "set -gx SSH_AUTH_SOCK '%s'\n" "$agent_sock"
            ;;
        *)
            return 1
            ;;
    esac
}

case "${1:-}" in
    env)
        is_wsl || exit 0
        # On failure leave SSH_AUTH_SOCK alone rather than point it at a dead socket.
        ensure_agent || exit 1
        emit_env "${2:-sh}"
        ;;
    '')
        ensure_agent
        ;;
    *)
        printf 'usage: %s [env [sh|fish]]\n' "$0" >&2
        exit 1
        ;;
esac
