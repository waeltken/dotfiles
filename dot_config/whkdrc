.shell powershell

# Reload whkd configuration
# win + alt + o                 : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
win + alt + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden # if shell is pwsh / powershell
win + alt + shift + o         : komorebic reload-configuration

win + alt + i                 : komorebic toggle-shortcuts

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# win + alt + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# win + alt + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }

win + alt + q                 : komorebic close
win + alt + m                 : komorebic minimize
win + alt + s                 : komorebic toggle-lock

# Focus windows
win + alt + h                 : komorebic focus left
win + alt + j                 : komorebic focus down
win + alt + k                 : komorebic focus up
win + alt + l                 : komorebic focus right
win + alt + oem_4             : komorebic cycle-focus previous # oem_4 is [
win + alt + oem_6             : komorebic cycle-focus next # oem_6 is ]

# Move windows
win + alt + shift + h         : komorebic move left
win + alt + shift + j         : komorebic move down
win + alt + shift + k         : komorebic move up
win + alt + shift + l         : komorebic move right
win + alt + shift + return    : komorebic promote

# Stack windows
win + alt + left              : komorebic stack left
win + alt + down              : komorebic stack down
win + alt + up                : komorebic stack up
win + alt + right             : komorebic stack right
win + alt + oem_1             : komorebic unstack # oem_1 is ;
win + alt + shift + oem_4     : komorebic cycle-stack previous # oem_4 is [
win + alt + shift + oem_6     : komorebic cycle-stack next # oem_6 is ]

# Resize
win + alt + oem_plus          : komorebic resize-axis horizontal increase
win + alt + oem_minus         : komorebic resize-axis horizontal decrease
win + alt + shift + oem_plus  : komorebic resize-axis vertical increase
win + alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
win + alt + t                 : komorebic toggle-float
win + alt + f                 : komorebic toggle-monocle

# Window manager options
win + alt + shift + r         : komorebic retile
win + alt + p                 : komorebic toggle-pause

# Layouts
win + alt + x                 : komorebic flip-layout horizontal
win + alt + y                 : komorebic flip-layout vertical

# Workspaces
win + alt + 1                 : komorebic focus-monitor-workspace 0 0
win + alt + 2                 : komorebic focus-monitor-workspace 0 1
win + alt + 3                 : komorebic focus-monitor-workspace 0 2
win + alt + 4                 : komorebic focus-monitor-workspace 0 3
win + alt + 5                 : komorebic focus-monitor-workspace 0 4
win + alt + 6                 : komorebic focus-monitor-workspace 0 5
win + alt + shift + 1         : komorebic move-to-monitor-workspace 0 0
win + alt + shift + 2         : komorebic move-to-monitor-workspace 0 1
win + alt + shift + 3         : komorebic move-to-monitor-workspace 0 2
win + alt + shift + 4         : komorebic move-to-monitor-workspace 0 3
win + alt + shift + 5         : komorebic move-to-monitor-workspace 0 4
win + alt + shift + 6         : komorebic move-to-monitor-workspace 0 5

# Presentation monitor workspaces
win + alt + ctrl + 1          : komorebic focus-monitor-workspace 1 0
win + alt + ctrl + 2          : komorebic focus-monitor-workspace 1 1
win + alt + ctrl + 3          : komorebic focus-monitor-workspace 1 2
win + alt + ctrl + shift + 1  : komorebic move-to-monitor-workspace 1 0
win + alt + ctrl + shift + 2  : komorebic move-to-monitor-workspace 1 1
win + alt + ctrl + shift + 3  : komorebic move-to-monitor-workspace 1 2
